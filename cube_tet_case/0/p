FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 99000;

boundaryField
{
    inlet
    {
        type            totalPressure;
        p0              uniform 101352.9322095696;
        rho             none;
        psi             thermo:psi;
        gamma           1.4;
        value           uniform 99000;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 96526.602104352;
    }

    walls
    {
        type            zeroGradient;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

