FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (10 0 0);

boundaryField
{
    inlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (10 0 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (10 0 0);
    }

    walls
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

